---
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	width?: number;
	additionalSrcs?: ImageMetadata[];
}

const { src, alt, width, additionalSrcs } = Astro.props;
const allSrcs = [src, ...(additionalSrcs ?? [])];
const isCarousel = allSrcs.length > 1;
const totalDuration = allSrcs.length * 4;
---

<div class="browser-mockup">
	<div class="browser-chrome">
		<span class="dot"></span>
		<span class="dot"></span>
		<span class="dot"></span>
	</div>
	<div class={`browser-content ${isCarousel ? 'carousel' : ''}`}>
		{allSrcs.map((s, i) => (
			<Image
				src={s}
				alt={alt}
				width={width || s.width}
				format="avif"
				quality={80}
				style={isCarousel
					? `animation-duration: ${totalDuration}s; animation-delay: ${i * 4 - 1}s;`
					: undefined}
			/>
		))}
	</div>
</div>

<style>
	.browser-mockup {
		border: 3px solid var(--border);
		box-shadow: var(--box-shadow);
		border-radius: 8px;
		overflow: hidden;
		background: var(--bg);
	}
	.browser-chrome {
		display: flex;
		gap: 6px;
		padding: 10px 12px;
		border-bottom: 3px solid var(--border);
		background: rgb(var(--gray-light));
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 2px solid var(--border);
		background: var(--accent);
	}
	.dot:nth-child(2) {
		background: rgb(var(--gray-dark));
	}
	.dot:nth-child(3) {
		background: var(--bg);
	}
	.browser-content {
		line-height: 0;
	}
	.browser-content img {
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.browser-content.carousel {
		position: relative;
	}
	.browser-content.carousel img {
		animation-name: fade;
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
		animation-fill-mode: backwards;
	}
	.browser-content.carousel img:not(:first-child) {
		position: absolute;
		inset: 0;
		opacity: 0;
	}
	@keyframes fade {
		0% { opacity: 0; }
		8% { opacity: 1; }
		33% { opacity: 1; }
		41% { opacity: 0; }
		100% { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.browser-content.carousel img {
			animation: none;
		}
		.browser-content.carousel img:not(:first-child) {
			display: none;
		}
	}
</style>
